    "apps-script:build": "tsx scripts/build-apps-script.ts",
    "apps-script:check": "tsx scripts/build-apps-script.ts --check",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run docs:check && npm run apps-script:check && npm run build"
